# Required. Get it from @BotFather.
BOT_TOKEN=123456789:replace-with-your-token

# Required. Comma-separated Telegram user IDs allowed to use the bot, e.g. 123456789,987654321
# (get your ID from @userinfobot). If this is empty the bot refuses to start.
ALLOWED_USER_IDS=

# Only for a deliberately public bot: accept everyone and ignore the list above.
# ALLOW_EVERYONE=true

# Optional: Telegram API proxy, the URL must contain the {0} and {1} placeholders.
# TELEGRAM_API_URL=https://your-worker.example.workers.dev/bot{0}/{1}

# Optional overrides (defaults shown).
# DATABASE_PATH=data/tracker.db
# CHECK_INTERVAL_SECONDS=14400
# REQUEST_DELAY_SECONDS=5
# MAX_PRODUCTS_PER_USER=20

# Development only: save the HTML of pages that fail to parse.
DEBUG_HTML_DIR=debug
